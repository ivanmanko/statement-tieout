# The model-backed rungs are optional: with nothing set here, extraction runs
# the deterministic path only, which is what produces every number in the
# README. Set a provider to enable rung 2 (SPEC §4).

# --- OpenAI-compatible endpoint (DeepSeek by default) ------------------------
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# --- or Claude, on whichever platform this installation is pointed at --------
# LLM_PROVIDER=anthropic
# LLM_PLATFORM=anthropic          # anthropic | bedrock | vertex | foundry
# LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# AWS_REGION=                     # LLM_PLATFORM=bedrock
# GOOGLE_CLOUD_PROJECT=           # LLM_PLATFORM=vertex
